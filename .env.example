# Copy this file to .env or pass your existing root .env with --env-file.
# Do not commit real passwords or app passwords.

POSTGRES_DB=gps_guardian_escolar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

BACKEND_PORT=8080
FRONTEND_PORT=8081

JWT_SECRET=
JWT_EXPIRATION_MINUTES=30
REQUIRE_HTTPS=false

CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
FRONTEND_BASE_URL=http://localhost:8081
API_PUBLIC_BASE_URL=http://localhost:8080

EXPO_PUBLIC_API_URL=/api
EXPO_PUBLIC_WS_URL=/ws
EXPO_PUBLIC_STUDENT_LINK_BASE_URL=/
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

APP_MAIL_ENABLED=false
APP_MAIL_FROM=no-reply@guardianescolar.local
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

GPS_DESVIO_UMBRAL_METROS=150

EXPO_PUSH_ENABLED=false
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

SMS_ENABLED=false
SMS_PROVIDER=TEXTBELT
SMS_PROVIDER_URL=https://textbelt.com/text
SMS_API_KEY=
SMS_FROM=GuardianEscolar
